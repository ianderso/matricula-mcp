# Copy to .env to change a default. Nothing here is required: Matricula's
# catalogue pages need no key and no account.
#
# The server reads .env from the directory it is started in -- the
# repository root, when launched with `uv --directory /path/to/matricula-mcp`.
# Variables already set in the environment take precedence.

# Recommended: an email address or URL added to the User-Agent, so ICARUS can
# reach you if your use ever causes it trouble. Required for image access.
# MATRICULA_CONTACT=you@example.org

# Optional: directory for the on-disk response cache.
# MATRICULA_CACHE_DIR=~/.cache/matricula-mcp

# Optional: HTTP timeout in seconds for one request (default 30; image
# downloads get 120 to read).
# MATRICULA_TIMEOUT=30

# Optional: least seconds between two requests to Matricula (default 2, never
# below 2).
# MATRICULA_MIN_INTERVAL=2

# Optional: least seconds between two place searches (default 10, never below
# 10). A search costs the site far more than a page does.
# MATRICULA_SEARCH_INTERVAL=10

# Optional: an existing folder that every saved page image must lie inside.
# The image tool never writes under ~/Library otherwise; set this to save
# into an iCloud Drive folder, which lives there.
# MATRICULA_DOWNLOAD_DIR="~/Library/Mobile Documents/com~apple~CloudDocs/Genealogy"

# Leave this unset. Matricula's image host refuses scripted requests, and this
# server does not get past that: page images are read in Matricula's viewer.
# Set it to "granted" only once ICARUS has granted your client access to its
# image host (it also needs MATRICULA_CONTACT, the address ICARUS knows you
# by). Any other value is refused.
# MATRICULA_IMAGE_ACCESS=granted
